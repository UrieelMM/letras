# Configuración de Firebase (REQUERIDA).
# Copia este archivo como ".env" y rellena con los valores de tu proyecto.
# (Firebase Console → Configuración del proyecto → Tus apps → SDK config)
#
# La app guarda TODO en la nube (Firestore). Sin estas llaves verás una
# pantalla pidiendo configurarlas; no hay modo local.

VITE_FIREBASE_API_KEY=
# Usa el valor exacto del SDK, normalmente: TU_PROYECTO.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
