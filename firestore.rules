rules_version = '2';

// Biblioteca común; los documentos anteriores se conservan para migración.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /libraries/shared/{document=**} {
      allow read, write: if request.auth != null;
    }

    function folderIsOpen(folderId) {
      return folderId == null || (
        folderId is string &&
        get(/databases/$(database)/documents/resourceFolders/$(folderId)).data.get('deleting', false) == false
      );
    }

    match /resources/{resourceId} {
      allow read, delete: if request.auth != null;
      allow create: if request.auth != null &&
        folderIsOpen(request.resource.data.get('folderId', null));
      allow update: if request.auth != null &&
        folderIsOpen(resource.data.get('folderId', null)) &&
        folderIsOpen(request.resource.data.get('folderId', null));
    }

    match /resourceFolders/{folderId} {
      allow read, create, delete: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.get('deleting', false) == false ||
        request.resource.data.get('deleting', false) == true
      );
    }
  }
}
