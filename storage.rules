rules_version = '2';

// Biblioteca compartida entre las cuentas autenticadas.
service firebase.storage {
  match /b/{bucket}/o {
    match /resources/{resourceId} {
      allow get, delete: if request.auth != null;
      allow create: if request.auth != null && request.resource.size > 0 && (
        (request.resource.contentType.matches('image/(jpeg|png|webp|gif|avif)') &&
          request.resource.size <= 25 * 1024 * 1024) ||
        (request.resource.contentType.matches('video/(mp4|webm)') &&
          request.resource.size <= 250 * 1024 * 1024)
      );
    }
  }
}
